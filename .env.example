# Local backend default. Docker Compose overrides this with its persistent /data volume.
DATABASE_URL=sqlite:///./data/dashboard.db

# Browser origin allowed to call the API during local development.
FRONTEND_ORIGIN=http://localhost:3000
FILE_STORAGE_DIR=./data/files
MAX_RESUME_SIZE_MB=10
# Required to save an iCalendar subscription. Generate a Fernet key with Python secrets.
CALENDAR_ENCRYPTION_KEY=

# Optional Ollama endpoint reachable from the API process. Keep private.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=45
